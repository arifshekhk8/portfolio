{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "jsx-a11y"],
  "categories": { "correctness": "error", "suspicious": "warn" },
  "rules": {
    "react/no-unknown-property": "off",
    "no-unused-vars": "warn"
  },
  "ignorePatterns": ["dist", "node_modules"]
}
